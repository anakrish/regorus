%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '13px'}}}%%
flowchart TB
    subgraph Eager["❌ Eager Evaluation (Before)"]
        direction TB
        E1["Load type field"] --> E2["BuiltinCall: equals\n<i>3 heap allocs</i>"]
        E2 --> E3["Load httpsOnly field"]
        E3 --> E4["BuiltinCall: equals\n<i>3 heap allocs</i>"]
        E4 --> E5["BuiltinCall: logic_all\n<i>3 heap allocs</i>"]
        E5 --> E6{"Result?"}
        E6 -->|true| EDeny["deny"]
        E6 -->|false| EAllow["allow"]
    end

    subgraph Lazy["✅ Lazy Short-Circuit (After)"]
        direction TB
        L1["Load type field"] --> L2["PolicyOp: Equals\n<i>0 heap allocs</i>"]
        L2 --> L3{"AllOfGuard\ntype matches?"}
        L3 -->|"NO → jump to END\n⚡ Skip everything"| LEND["END: result = false"]
        L3 -->|"YES → continue"| L4["Load httpsOnly field"]
        L4 --> L5["PolicyOp: Equals\n<i>0 heap allocs</i>"]
        L5 --> L6{"AllOfGuard\nhttps = false?"}
        L6 -->|"NO → jump to END"| LEND
        L6 -->|"YES → all passed"| LTrue["result = true"]
        LTrue --> LEND2["END"]
        LEND --> LFinal{"ReturnUndefinedIfNotTrue"}
        LEND2 --> LFinal
        LFinal -->|true| LDeny["deny"]
        LFinal -->|false| LAllow["allow"]
    end

    style Eager fill:#ffebee,stroke:#c62828,stroke-width:2px
    style Lazy fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style E2 fill:#ffcdd2,stroke:#c62828
    style E4 fill:#ffcdd2,stroke:#c62828
    style E5 fill:#ffcdd2,stroke:#c62828
    style L2 fill:#c8e6c9,stroke:#2e7d32
    style L5 fill:#c8e6c9,stroke:#2e7d32
    style L3 fill:#fff9c4,stroke:#f57f17,stroke-width:2px
    style L6 fill:#fff9c4,stroke:#f57f17,stroke-width:2px
