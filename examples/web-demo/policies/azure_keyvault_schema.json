{
  "type": "object",
  "required": ["resource"],
  "properties": {
    "resource": {
      "type": "object",
      "required": [
        "type", "sku.name", "sku.family", "tenantId",
        "enableSoftDelete", "enablePurgeProtection", "enableRbacAuthorization",
        "enabledForDeployment", "enabledForDiskEncryption", "enabledForTemplateDeployment",
        "softDeleteRetentionInDays", "createMode", "publicNetworkAccess",
        "networkAcls.defaultAction", "networkAcls.bypass"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Microsoft.KeyVault/vaults"]
        },
        "sku.name": {
          "type": "string",
          "enum": ["standard", "premium"]
        },
        "sku.family": {
          "type": "string",
          "enum": ["A"]
        },
        "tenantId": {
          "type": "string"
        },
        "enableSoftDelete": {
          "type": "boolean",
          "default": true
        },
        "enablePurgeProtection": {
          "type": "boolean",
          "default": false
        },
        "enableRbacAuthorization": {
          "type": "boolean",
          "default": false
        },
        "enabledForDeployment": {
          "type": "boolean",
          "default": false
        },
        "enabledForDiskEncryption": {
          "type": "boolean",
          "default": false
        },
        "enabledForTemplateDeployment": {
          "type": "boolean",
          "default": false
        },
        "softDeleteRetentionInDays": {
          "type": "integer",
          "minimum": 7,
          "maximum": 90,
          "default": 90
        },
        "createMode": {
          "type": "string",
          "enum": ["default", "recover"]
        },
        "publicNetworkAccess": {
          "type": "string",
          "enum": ["Enabled", "Disabled"]
        },
        "networkAcls.defaultAction": {
          "type": "string",
          "enum": ["Allow", "Deny"],
          "default": "Allow"
        },
        "networkAcls.bypass": {
          "type": "string",
          "enum": ["AzureServices", "None"],
          "default": "AzureServices"
        },
        "tags": {
          "type": "object",
          "description": "Resource tags",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "context": {
      "type": "object"
    }
  }
}
